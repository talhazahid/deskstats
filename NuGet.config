<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet source configuration for SysDash.

  The default source api.nuget.org is unreachable on some networks (this machine
  could not open a TCP connection to it), so the build uses Huawei Cloud's
  mirror of the nuget.org feed instead. It is a byte-for-byte proxy of the
  official feed and serves the exact pinned package versions.

  If your network has normal access to api.nuget.org, you can delete this file
  (or replace the source below) to use the official feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="huaweicloud-nuget" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" />
  </packageSources>
</configuration>