<UserControl x:Class="SysDash.Widgets.Ram.RamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:SysDash.Theming.Controls;assembly=SysDash.Theming"
             MinWidth="240">

    <Border Style="{StaticResource WidgetCard}">
        <!-- Fluid: 1 column at the default width, 2–3 columns when the widget is widened. -->
        <s:ResponsiveColumns MinColumnWidth="264" MaxColumns="3" ColumnGap="8">
            <Border Style="{StaticResource WidgetSection}">
                <s:SectionLayout>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="MEMORY (RAM)" />
                            <Border Style="{StaticResource AlertBadge}" Visibility="{Binding IsUsageAlert, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding AlertText}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="86" Height="86" HorizontalAlignment="Center" Margin="0,2">
                        <s:RingGauge Value="{Binding UsedPercent}" Thickness="7" RingBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource TrackBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RingValue}" FontSize="20" Text="{Binding UsedText}" />
                            <TextBlock Style="{StaticResource RingCaption}" Text="RAM" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" Width="86" Height="86" HorizontalAlignment="Center" Margin="0,2">
                        <s:RingGauge Value="{Binding VirtualPercent}" Thickness="7" RingBrush="{DynamicResource PinkBrush}" TrackBrush="{DynamicResource TrackBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RingValue}" FontSize="20" Text="{Binding VirtualText}" />
                            <TextBlock Style="{StaticResource RingCaption}" Text="COMMITTED" />
                        </StackPanel>
                    </Grid>
                    </Grid>
                    <s:BarGraph Height="22" Margin="0,8,0,0" Values="{Binding Sparkline}" Maximum="100"
                                Capacity="{Binding GraphCapacity}" Visibility="{Binding ShowGraph, Converter={StaticResource BoolToVisibility}}"
                                BarBrush="{DynamicResource AccentBrush}" />
                </s:SectionLayout>
            </Border>
            <Border Style="{StaticResource WidgetSection}" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                <s:SectionLayout>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="In use" />
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding UsedBytesText}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource SecondarySeriesBrush}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Available" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding FreeBytesText}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource PinkBrush}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Committed" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding VirtualBytesText}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource RowLabel}" Text="Installed" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding TotalBytesText}" />
                    </Grid>
                </s:SectionLayout>
            </Border>
            <Border Style="{StaticResource WidgetSection}" Margin="0" Visibility="{Binding ShowProcesses, Converter={StaticResource BoolToVisibility}}">
                <s:SectionLayout>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="PROCESS MEMORY" />
                    <ItemsControl ItemsSource="{Binding Processes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding ValueText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </s:SectionLayout>
            </Border>
        </s:ResponsiveColumns>
    </Border>
</UserControl>
