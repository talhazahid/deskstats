<UserControl x:Class="SysDash.Widgets.Media.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="240" MinHeight="150">

    <Border Style="{StaticResource WidgetCard}" Padding="16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Album art -->
            <Border Width="72" Height="72" CornerRadius="10"
                    Background="{DynamicResource TrackBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="🎵" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                </Grid>
            </Border>

            <!-- Track info -->
            <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"
                               Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding AppNameText}" Style="{StaticResource WidgetLabel}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Style="{StaticResource WidgetValue}" FontSize="20"
                           Text="{Binding TitleText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />

                <TextBlock Grid.Row="2" Style="{StaticResource WidgetLabel}" Text="{Binding ArtistText}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>