<UserControl x:Class="SysDash.Widgets.Sensors.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:SysDash.Theming.Controls;assembly=SysDash.Theming"
             MinWidth="240">

    <Border Style="{StaticResource WidgetCard}">
        <!-- Fluid: 1 column at the default width, 2–3 columns when the widget is widened. -->
        <s:ResponsiveColumns MinColumnWidth="264" MaxColumns="3" ColumnGap="8">
            <!-- Shown when CPU sensors are unavailable (PawnIO driver missing / not admin). -->
            <Border Style="{StaticResource WidgetSection}" s:ResponsiveColumns.FullRow="True" Visibility="{Binding HasDriverHint, Converter={StaticResource BoolToVisibility}}">
                <s:SectionLayout>
                    <TextBlock Style="{StaticResource RowLabel}" TextWrapping="Wrap" TextTrimming="None" Text="{Binding DriverHint}" />
                    <Button HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding InstallDriverCommand}" Content="{Binding InstallButtonText}" />
                </s:SectionLayout>
            </Border>
            <Border Style="{StaticResource WidgetSection}">
                <s:SectionLayout>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="SENSORS" />
                            <Border Style="{StaticResource AlertBadge}" Visibility="{Binding IsTempAlert, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding AlertText}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="74" Height="74" HorizontalAlignment="Center" Margin="0,2">
                        <s:RingGauge Value="{Binding CpuTempPercent}" Thickness="5" RingBrush="{DynamicResource WarningBrush}" TrackBrush="{DynamicResource TrackBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RingValue}" FontSize="16" Text="{Binding CpuTempText}" />
                            <TextBlock Style="{StaticResource RingCaption}" Text="CPU" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" Width="74" Height="74" HorizontalAlignment="Center" Margin="0,2">
                        <s:RingGauge Value="{Binding GpuTempPercent}" Thickness="5" RingBrush="{DynamicResource WarningBrush}" TrackBrush="{DynamicResource TrackBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RingValue}" FontSize="16" Text="{Binding GpuTempText}" />
                            <TextBlock Style="{StaticResource RingCaption}" Text="GPU" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="2" Width="74" Height="74" HorizontalAlignment="Center" Margin="0,2">
                        <s:RingGauge Value="{Binding FanPercent}" Thickness="5" RingBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource TrackBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RingValue}" FontSize="16" Text="{Binding FanText}" />
                            <TextBlock Style="{StaticResource RingCaption}" Text="FANS" />
                        </StackPanel>
                    </Grid>
                    </Grid>
                </s:SectionLayout>
            </Border>
            <Border Style="{StaticResource WidgetSection}" Visibility="{Binding HasTemperatures, Converter={StaticResource BoolToVisibility}}">
                <s:SectionLayout>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="TEMPERATURE" />
                    <ItemsControl ItemsSource="{Binding Temperatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding ValueText}" />
                                    <s:RingGauge Grid.Column="2" Width="14" Height="14" Margin="8,0,0,0" Thickness="2.5"
                                                 Value="{Binding Percent}"
                                                 RingBrush="{DynamicResource AccentBrush}"
                                                 TrackBrush="{DynamicResource TrackBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </s:SectionLayout>
            </Border>
            <Border Style="{StaticResource WidgetSection}" Margin="0" Visibility="{Binding HasFans, Converter={StaticResource BoolToVisibility}}">
                <s:SectionLayout>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="FANS" />
                    <ItemsControl ItemsSource="{Binding Fans}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding ValueText}" />
                                    <s:RingGauge Grid.Column="2" Width="14" Height="14" Margin="8,0,0,0" Thickness="2.5"
                                                 Value="{Binding Percent}"
                                                 RingBrush="{DynamicResource AccentBrush}"
                                                 TrackBrush="{DynamicResource TrackBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </s:SectionLayout>
            </Border>
        </s:ResponsiveColumns>
    </Border>
</UserControl>
