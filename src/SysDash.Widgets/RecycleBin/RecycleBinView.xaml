<UserControl x:Class="SysDash.Widgets.RecycleBin.RecycleBinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="240" MinHeight="130">

    <Border Style="{StaticResource WidgetCard}" Padding="16,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconGlyph}" Data="{StaticResource Icon.Recycle}" />
                <TextBlock Style="{StaticResource WidgetTitle}" Text="RECYCLE BIN" Margin="8,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,8,0,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource WidgetValue}" Text="{Binding CountText}" />
                </StackPanel>
                <TextBlock Style="{StaticResource WidgetLabel}" Text="{Binding SizeText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{Binding SizeText, Converter={StaticResource NullToVisibility}}" />
            </Grid>

            <Button Grid.Row="2" Content="Empty bin"
                    Command="{Binding EmptyCommand}"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Left"
                    Padding="12,5" FontSize="12"
                    Background="Transparent" BorderBrush="{DynamicResource PanelBorderBrush}"
                    Foreground="{DynamicResource DangerBrush}" BorderThickness="1"
                    Cursor="Hand" />
        </Grid>
    </Border>
</UserControl>