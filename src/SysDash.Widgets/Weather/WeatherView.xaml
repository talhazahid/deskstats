<UserControl x:Class="SysDash.Widgets.Weather.WeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:SysDash.Theming.Controls;assembly=SysDash.Theming"
             MinWidth="240">

    <Border Style="{StaticResource WidgetCard}">
        <!-- Fluid: 1 column at the default width, 2–3 columns when the widget is widened. -->
        <s:ResponsiveColumns MinColumnWidth="264" MaxColumns="3" ColumnGap="8">
            <!-- Now -->
            <Border Style="{StaticResource WidgetSection}">
                <s:SectionLayout>
                    <Grid>
                        <TextBlock Text="{Binding TempText}" FontSize="50" FontWeight="Light"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,-6,0,0" />
                        <TextBlock Text="{Binding IconEmoji}" FontSize="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   FontFamily="Segoe UI Emoji" Foreground="{DynamicResource WarningBrush}" />
                    </Grid>
                    <Grid Margin="0,2,0,6">
                        <TextBlock Text="{Binding LocationText}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource RowLabel}" HorizontalAlignment="Right" Margin="0"
                                   Text="{Binding ConditionText}" />
                    </Grid>
                    <!-- At a glance: humidity · rain chance · wind, each with a label -->
                    <UniformGrid Rows="1" Margin="0,2,0,10">
                        <StackPanel HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="💧" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding HumidityText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Humidity" FontSize="10.5" HorizontalAlignment="Left" Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="☔" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding RainChanceText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Rain chance" FontSize="10.5" HorizontalAlignment="Center" Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="🌬" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding WindText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Wind" FontSize="10.5" HorizontalAlignment="Right" Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </UniformGrid>
                    <!-- Air quality on its own line so the full rating always fits -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Air quality" Margin="0,0,10,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Margin="0" TextAlignment="Right"
                                   HorizontalAlignment="Right" TextWrapping="Wrap" TextTrimming="None" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding AirText}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}"><Run Text="Dew point " /><Run Text="{Binding DewPointText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /></TextBlock>
                            <TextBlock Style="{StaticResource RowLabel}"><Run Text="Visibility " /><Run Text="{Binding VisibilityText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource RowLabel}" HorizontalAlignment="Right"><Run Text="Feels like " /><Run Text="{Binding FeelsLikeText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /></TextBlock>
                            <TextBlock Style="{StaticResource RowLabel}" HorizontalAlignment="Right"><Run Text="UV index " /><Run Text="{Binding UvText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /></TextBlock>
                        </StackPanel>
                    </Grid>
                </s:SectionLayout>
            </Border>

            <!-- Hourly -->
            <Border Style="{StaticResource WidgetSection}"
                    Visibility="{Binding ShowHourly, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Hourly}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontSize="11.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Precip}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Icon}" FontSize="17" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource WarningBrush}" Margin="0,4" />
                                <TextBlock Text="{Binding Temp}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Next days -->
            <Border Style="{StaticResource WidgetSection}"
                    Visibility="{Binding ShowDays, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Day}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Icon}" FontSize="20" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center"
                                           Margin="0,4" />
                                <TextBlock HorizontalAlignment="Center" FontSize="12">
                                    <Run Text="{Binding High, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Run Text="{Binding Low, Mode=OneWay}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Today -->
            <Border Style="{StaticResource WidgetSection}" Margin="0">
                <s:SectionLayout>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TodayIcon}" FontSize="15" FontFamily="Segoe UI Emoji" Margin="0,0,8,0"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Today" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding TodayPrecipText}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding TodayRangeText}" />
                    </Grid>
                    <TextBlock Style="{StaticResource RowLabel}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{Binding TodaySummary}" />
                    <TextBlock Style="{StaticResource RowLabel}" FontSize="10.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding UpdatedText}" />
                </s:SectionLayout>
            </Border>
        </s:ResponsiveColumns>
    </Border>
</UserControl>
