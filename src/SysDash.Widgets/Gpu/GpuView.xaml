<UserControl x:Class="SysDash.Widgets.Gpu.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:SysDash.Theming.Controls;assembly=SysDash.Theming"
             MinWidth="240">

    <Border Style="{StaticResource WidgetCard}">
        <!-- Fluid: 1 column at the default width, 2–3 columns when the widget is widened. -->
        <s:ResponsiveColumns MinColumnWidth="264" MaxColumns="3" ColumnGap="8">
            <Border Style="{StaticResource WidgetSection}">
                <s:SectionLayout>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="GPU" />
                            <Border Style="{StaticResource AlertBadge}" Visibility="{Binding IsTempAlert, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding AlertText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RowValue}" Margin="0" Text="{Binding NameText}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                    </Grid>
                    <s:BarGraph Height="56" Margin="0,4,0,4" Values="{Binding Sparkline}" Maximum="100"
                                Capacity="{Binding GraphCapacity}" Visibility="{Binding ShowGraph, Converter={StaticResource BoolToVisibility}}"
                                BarBrush="{DynamicResource AccentBrush}" />
                </s:SectionLayout>
            </Border>
            <Border Style="{StaticResource WidgetSection}" Visibility="{Binding ShowRings, Converter={StaticResource BoolToVisibility}}">
                <s:SectionLayout>
                    <UniformGrid Rows="1" Margin="0,2">
                    <Grid Width="58" Height="58" HorizontalAlignment="Center" Margin="0,2">
                        <s:RingGauge Value="{Binding LoadPercent}" Thickness="5" RingBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource TrackBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RingValue}" FontSize="13" Text="{Binding LoadText}" />
                            <TextBlock Style="{StaticResource RingCaption}" Text="LOAD" />
                        </StackPanel>
                    </Grid>
                    <Grid Width="58" Height="58" HorizontalAlignment="Center" Margin="0,2" Visibility="{Binding ShowVram, Converter={StaticResource BoolToVisibility}}">
                        <s:RingGauge Value="{Binding VramPercent}" Thickness="5" RingBrush="{DynamicResource PurpleBrush}" TrackBrush="{DynamicResource TrackBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RingValue}" FontSize="13" Text="{Binding VramPercentText}" />
                            <TextBlock Style="{StaticResource RingCaption}" Text="VRAM" />
                        </StackPanel>
                    </Grid>
                    <Grid Width="58" Height="58" HorizontalAlignment="Center" Margin="0,2" Visibility="{Binding ShowTemperature, Converter={StaticResource BoolToVisibility}}">
                        <s:RingGauge Value="{Binding TempPercent}" Thickness="5" RingBrush="{DynamicResource WarningBrush}" TrackBrush="{DynamicResource TrackBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RingValue}" FontSize="13" Text="{Binding TempShortText}" />
                            <TextBlock Style="{StaticResource RingCaption}" Text="TEMP" />
                        </StackPanel>
                    </Grid>
                    <Grid Width="58" Height="58" HorizontalAlignment="Center" Margin="0,2" Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}">
                        <s:RingGauge Value="{Binding ClockPercent}" Thickness="5" RingBrush="{DynamicResource SuccessBrush}" TrackBrush="{DynamicResource TrackBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RingValue}" FontSize="13" Text="{Binding ClockShortText}" />
                            <TextBlock Style="{StaticResource RingCaption}" Text="GHZ" />
                        </StackPanel>
                    </Grid>
                    </UniformGrid>
                </s:SectionLayout>
            </Border>
            <Border Style="{StaticResource WidgetSection}" Margin="0" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                <s:SectionLayout>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="GPU DETAILS" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Visibility="{Binding ShowVram, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource PurpleBrush}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Video memory (VRAM)" />
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding VramText}" Visibility="{Binding ShowVram, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="{Binding ShowTemperature, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource WarningBrush}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Temperature" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding TempText}" Visibility="{Binding ShowTemperature, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource SuccessBrush}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Core clock" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding ClockText}" Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource RowLabel}" Text="Memory clock" Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding MemClockText}" Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource RowLabel}" Text="GPU fan" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding FanText}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource RowLabel}" Text="Voltage" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding VoltageText}" />
                    </Grid>
                </s:SectionLayout>
            </Border>
        </s:ResponsiveColumns>
    </Border>
</UserControl>
