<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SysDash.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DeskStats logo: exe icon in Explorer, taskbar, Start menu and every shortcut. -->
    <ApplicationIcon>Assets\DeskStats.ico</ApplicationIcon>
    <AssemblyName>DeskStats</AssemblyName>
    <Product>DeskStats</Product>
    <Description>DeskStats — PC monitor widgets for your desktop.</Description>
  </PropertyGroup>

  <!-- Microsoft Store (MSIX) build: no administrator elevation (see scripts\build-msix.ps1). -->
  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <ApplicationManifest>app.store.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same icon embedded as a WPF resource for the tray and the windows. -->
    <Resource Include="Assets\DeskStats.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SysDash.Core\SysDash.Core.csproj" />
    <ProjectReference Include="..\SysDash.SDK\SysDash.SDK.csproj" />
    <ProjectReference Include="..\SysDash.Monitoring\SysDash.Monitoring.csproj" />
    <ProjectReference Include="..\SysDash.Theming\SysDash.Theming.csproj" />
    <ProjectReference Include="..\SysDash.Layouts\SysDash.Layouts.csproj" />
    <ProjectReference Include="..\SysDash.Widgets\SysDash.Widgets.csproj" />
  </ItemGroup>

</Project>
