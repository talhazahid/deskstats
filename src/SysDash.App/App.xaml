<Application x:Class="SysDash.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme brushes + shared styles live in SysDash.Theming. -->
                <ResourceDictionary Source="pack://application:,,,/SysDash.Theming;component/Themes/Base.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SysDash.Theming;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>