<Window x:Class="SysDash.App.SensorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SysDash.App"
        Title="DeskStats — Sensor readings" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontWeight="Normal">
    <Border Padding="24" Background="{DynamicResource PanelBackgroundBrush}">
    <StackPanel>
        <TextBlock Text="Sensor readings in the Store edition" FontSize="22" FontWeight="Medium"
                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{x:Static local:SensorSetupWindow.SensorLimit}" />
        <Button x:Name="ContinueButton" Margin="0,20,0,0" Padding="12,9"
                Style="{StaticResource PrimaryActionButton}" IsDefault="True" IsCancel="True"
                FontSize="13" FontWeight="Normal" Content="Continue" Click="OnContinue" />
    </StackPanel>
    </Border>
</Window>
