<Window x:Class="SysDash.App.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskStats — App settings"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackdropBrush}">

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Monitoring -->
        <Border Style="{StaticResource WidgetCard}" Padding="14">
            <StackPanel>
                <TextBlock Text="Monitoring"
                           Style="{StaticResource WidgetTitle}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sensor poll interval (ms)"
                               Style="{StaticResource WidgetLabel}"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="PollBox"
                             Grid.Column="1"
                             Width="90"
                             Padding="4,2"
                             TextAlignment="Right" />
                </Grid>
                <CheckBox x:Name="GpuCheck" Content="Monitor GPU sensors" Margin="0,8,0,0" />
                <CheckBox x:Name="DrivesCheck" Content="Monitor drive usage (LogicalDisk perf counters)" />
                <CheckBox x:Name="NetworkCheck" Content="Monitor network throughput" />
                <TextBlock Text="Sensor selection applies on the next start."
                           Style="{StaticResource WidgetLabel}"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Appearance -->
        <Border Grid.Row="1" Style="{StaticResource WidgetCard}" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Appearance"
                           Style="{StaticResource WidgetTitle}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Theme"
                               Style="{StaticResource WidgetLabel}"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="130">
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Light" />
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="CardFrameCheck" Content="Show card frame (outer background and border)" Margin="0,10,0,0" />
                <TextBlock Text="Off: only the inner sections are drawn — a lighter, frameless look."
                           Style="{StaticResource WidgetLabel}"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="25,2,0,0" />
                <TextBlock Text="Widget spacing (px per side)" Style="{StaticResource WidgetLabel}" Margin="0,12,0,6" />
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Left" Style="{StaticResource WidgetLabel}" /><TextBox x:Name="PaddingLeftBox" TextChanged="OnSpacingChanged" Padding="4,2" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Right" Style="{StaticResource WidgetLabel}" /><TextBox x:Name="PaddingRightBox" TextChanged="OnSpacingChanged" Padding="4,2" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Top" Style="{StaticResource WidgetLabel}" /><TextBox x:Name="PaddingTopBox" TextChanged="OnSpacingChanged" Padding="4,2" /></StackPanel>
                    <StackPanel><TextBlock Text="Bottom" Style="{StaticResource WidgetLabel}" /><TextBox x:Name="PaddingBottomBox" TextChanged="OnSpacingChanged" Padding="4,2" /></StackPanel>
                </UniformGrid>
                <TextBlock x:Name="SpacingSummary" Text="0–100 per side. Applies when saved." TextWrapping="Wrap" Style="{StaticResource WidgetLabel}" FontSize="10" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="2" Style="{StaticResource WidgetCard}" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Sidebar"
                           Style="{StaticResource WidgetTitle}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Screen"
                               Style="{StaticResource WidgetLabel}"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="ScreenBox" Grid.Column="1" Width="300"
                              SelectionChanged="OnScreenPicked" />
                </Grid>
                <Button Content="Identify screens"
                        HorizontalAlignment="Right"
                        Margin="0,6,0,0"
                        Padding="12,4"
                        Click="OnIdentifyScreens" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Screen edge"
                               Style="{StaticResource WidgetLabel}"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="EdgeBox" Grid.Column="1" Width="130">
                        <ComboBoxItem Content="Right" />
                        <ComboBoxItem Content="Left" />
                    </ComboBox>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Card background opacity"
                               Style="{StaticResource WidgetLabel}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="SidebarOpacityText"
                               Grid.Column="1"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" />
                </Grid>
                <Slider x:Name="SidebarOpacitySlider"
                        Style="{StaticResource ModernSlider}"
                        Minimum="0" Maximum="100"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        SmallChange="5" LargeChange="10"
                        Margin="0,4,0,0"
                        ValueChanged="OnSidebarOpacityChanged" />
                <CheckBox x:Name="SidebarTitleCheck" Content="Show &quot;DeskStats&quot; title" Margin="0,8,0,0" />
                <CheckBox x:Name="SidebarBackgroundCheck" Content="Show sidebar background (restart to apply)" />
                <CheckBox x:Name="AutoHideCheck" Content="Auto-hide when the mouse leaves" />
                <CheckBox x:Name="PinCheck" Content="Pin (disable auto-hide)" />
                <TextBlock Text="Screens are named by where they sit and their model. Identify shows the name on each screen. The sidebar only appears while it holds docked widgets."
                           Style="{StaticResource WidgetLabel}"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Startup -->
        <Border Grid.Row="3" Style="{StaticResource WidgetCard}" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Startup"
                           Style="{StaticResource WidgetTitle}" />
                <CheckBox x:Name="AutostartCheck" Content="Start DeskStats with Windows" Margin="0,10,0,0" />
                <TextBlock Text="Updates" Style="{StaticResource WidgetTitle}" Margin="0,14,0,0" />
                <CheckBox x:Name="AutomaticUpdatesCheck" Content="Check for updates before opening widgets" Margin="0,8,0,0" />
                <TextBlock Text="Install when ready. Your layout is kept; Windows may request administrator approval. Store editions update through Microsoft Store."
                           Style="{StaticResource WidgetLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <Button Content="Check for updates…" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCheckUpdates" />
            </StackPanel>
        </Border>


    </Grid>
    </ScrollViewer>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="22,12,22,16">
            <Button Content="Cancel"
                    IsCancel="True"
                    Width="88"
                    Margin="0,0,10,0"
                    Click="OnCancel" />
            <Button Content="Save"
                    IsDefault="True"
                    Width="88"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
