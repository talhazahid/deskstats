<Window x:Class="SysDash.App.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskStats"
        Width="320"
        Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackdropBrush}"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: just the product name, quiet. Right-clicking any empty area
             (header, gaps between cards, below the last card) opens the same
             menu as the tray icon. -->
        <TextBlock x:Name="HeaderText" Margin="18,14,16,8" Text="DeskStats" FontFamily="{StaticResource UiFont}" FontSize="14"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />

        <!-- Widget stack -->
        <ScrollViewer x:Name="Scroller"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,2,12,12">
            <StackPanel x:Name="HostPanel" />
        </ScrollViewer>
    </Grid>
</Window>