<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Dark theme. Brushes are defined HERE (not in Base.xaml) on purpose:
      ThemeManager swaps this whole dictionary, and every widget references the
      brushes with DynamicResource, so a theme switch repaints everything live.
    -->

    <Color x:Key="WindowBackdropColor">#C90F0F13</Color>
    <Color x:Key="PanelBackgroundColor">#F21C1C20</Color>
    <Color x:Key="PanelBorderColor">#2EFFFFFF</Color>
    <Color x:Key="PanelBorderSoftColor">#14FFFFFF</Color>
    <Color x:Key="SectionBackgroundColor">#0FFFFFFF</Color>
    <Color x:Key="SectionBorderColor">#0AFFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#C7C7CC</Color>
    <Color x:Key="TextTertiaryColor">#8E8E93</Color>
    <Color x:Key="AccentColor">#3D8BFF</Color>
    <Color x:Key="AccentSoftColor">#333D8BFF</Color>
    <Color x:Key="AccentFillColor">#263D8BFF</Color>
    <Color x:Key="SecondarySeriesColor">#9A9AA2</Color>
    <Color x:Key="PinkColor">#FF4F8B</Color>
    <Color x:Key="PurpleColor">#A066FF</Color>
    <Color x:Key="DangerColor">#FF453A</Color>
    <Color x:Key="SuccessColor">#32D74B</Color>
    <Color x:Key="WarningColor">#FFD60A</Color>
    <Color x:Key="TrackColor">#2BFFFFFF</Color>
    <Color x:Key="OnAccentColor">#101014</Color>

    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#C90F0F13" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F21C1C20" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="PanelBorderSoftBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SectionBorderBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7C7CC" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3D8BFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#333D8BFF" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#263D8BFF" />
    <SolidColorBrush x:Key="SecondarySeriesBrush" Color="#9A9AA2" />
    <SolidColorBrush x:Key="PinkBrush" Color="#FF4F8B" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#A066FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#32D74B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD60A" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#101014" />

    <!-- Shadow under floating widget cards. -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Direction="270"
                      Opacity="0.35" Color="Black" />

    <!-- Card brushes (defaults; windows override them for opacity / no-frame). -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F21C1C20" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="CardSectionBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="CardSectionBorderBrush" Color="#0AFFFFFF" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8E8E93" />

</ResourceDictionary>
