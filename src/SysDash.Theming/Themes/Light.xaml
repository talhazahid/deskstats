<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Light theme. Brushes are defined HERE (not in Base.xaml) on purpose:
      ThemeManager swaps this whole dictionary, and every widget references the
      brushes with DynamicResource, so a theme switch repaints everything live.

      Design (round 6): crisp white cards on a cool frosted backdrop, cool-tinted
      inner sections instead of flat grey, slate text with strong contrast, and
      vivid but balanced series colours so rings and graphs pop on white.
    -->

    <Color x:Key="WindowBackdropColor">#EBE9EEF5</Color>
    <Color x:Key="PanelBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="PanelBorderColor">#1F1E293B</Color>
    <Color x:Key="PanelBorderSoftColor">#0F1E293B</Color>
    <Color x:Key="SectionBackgroundColor">#FFF4F7FB</Color>
    <Color x:Key="SectionBorderColor">#0D1E293B</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextTertiaryColor">#8391A7</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentSoftColor">#2E2563EB</Color>
    <Color x:Key="AccentFillColor">#1A2563EB</Color>
    <Color x:Key="SecondarySeriesColor">#94A3B8</Color>
    <Color x:Key="PinkColor">#E11D74</Color>
    <Color x:Key="PurpleColor">#7C3AED</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#EA8A0C</Color>
    <Color x:Key="TrackColor">#FFE5EAF1</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#EBE9EEF5" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#1F1E293B" />
    <SolidColorBrush x:Key="PanelBorderSoftBrush" Color="#0F1E293B" />
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#FFF4F7FB" />
    <SolidColorBrush x:Key="SectionBorderBrush" Color="#0D1E293B" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8391A7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E2563EB" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#1A2563EB" />
    <SolidColorBrush x:Key="SecondarySeriesBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="PinkBrush" Color="#E11D74" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#EA8A0C" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FFE5EAF1" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- Soft, cool shadow under floating widget cards (light needs much less than dark). -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="3" Direction="270"
                      Opacity="0.14" Color="#1E293B" />

    <!-- Card brushes (defaults; windows override them for opacity / no-frame). -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1F1E293B" />
    <SolidColorBrush x:Key="CardSectionBrush" Color="#FFF4F7FB" />
    <SolidColorBrush x:Key="CardSectionBorderBrush" Color="#0D1E293B" />

    <!-- Scrollbar: visibly darker on white so it can actually be seen. -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#98A3B4" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#64748B" />

</ResourceDictionary>
